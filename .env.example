# === Supabase (PostgreSQL) ===
# Dashboard → Project Settings → Database → Connection string → URI
#
# Para a app na Vercel (serverless), prefira o pooler Transaction (porta 6543):
# DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[SENHA]@aws-0-[REGION].pooler.supabase.com:6543/postgres
#
# Para migrar schema / scripts locais, use Session (porta 5432) ou Direct:
# ADMIN_DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[SENHA]@aws-0-[REGION].pooler.supabase.com:5432/postgres
#
# Se a senha tiver # @ % etc, URL-encode (# → %23)

DATABASE_URL=
ADMIN_DATABASE_URL=

# Supabase exige SSL
DATABASE_SSL=1

# Serverless: 1 conexão por instância (evita estourar limite do pooler)
DB_POOL_MAX=1

# Fuso (não use TZ — é reservado na Vercel)
APP_TIMEZONE=America/Sao_Paulo

DEFAULT_OPERADOR=admin@60minutos.local

# Sessão de login — OBRIGATÓRIO na Vercel (mín. 32 caracteres aleatórios)
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Senha do admin criado na 1ª migração (mín. 8 chars, 1 maiúscula, 1 número, 1 especial)
ADMIN_SENHA_INICIAL=

VENDAS_DEDUPE_A_PARTIR_DE=2026-09-01

# HEALTH_TOKEN=seu-token-secreto

# === E-mail pessoal (verificação SMTP) ===
# URL pública do site (link no e-mail). Ex.: https://vendas60.vercel.app
APP_BASE_URL=
APP_NOME_EMAIL=60 Vendas
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
SMTP_FROM=